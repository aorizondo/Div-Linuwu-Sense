[Unit]
Description=Permisos de los atributos sysfs de linuwu_sense
Documentation=https://github.com/aorizondo/Div-Linuwu-Sense
After=systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
# tmpfiles.d corre en el arranque, antes de que exista /sys/module/linuwu_sense,
# asi que los permisos hay que aplicarlos aqui, una vez cargado el modulo.
#
# El modulo se carga si hace falta: al reinstalar el paquete, dpkg reinicia
# este servicio, y sin esto el sysfs se quedaria sin permisos hasta el
# siguiente arranque.
ExecStart=-/sbin/modprobe linuwu_sense
ExecStart=/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/linuwu-sense.conf

# Sin ExecStop: descargar el modulo al parar el servicio convertia cualquier
# reinstalacion del paquete en una descarga del driver, porque dpkg reinicia
# el servicio y el ExecStop se ejecutaba antes de volver a arrancar.

[Install]
WantedBy=multi-user.target
