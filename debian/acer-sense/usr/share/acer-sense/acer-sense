def fila(etiqueta, widget, pista=None):
    caja = QVBoxLayout()
    linea = QHBoxLayout()
    lbl = QLabel(etiqueta)
    lbl.setMinimumWidth(170)
    linea.addWidget(lbl)
    linea.addWidget(widget, 1)
    caja.addLayout(linea)
    if pista:
        p = QLabel(pista)
        p.setObjectName("pista")
        p.setWordWrap(True)
        caja.addWidget(p)
    return caja


class PaginaMonitor(QWidget):
    def __init__(self):
        super().__init__()
        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
        raiz.setSpacing(14)
        t = QLabel("Monitorizacion")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        caja_temp = QGroupBox("TEMPERATURAS")
        rej = QGridLayout(caja_temp)
        self.medidores = {}
        for col, nombre in enumerate(("CPU", "GPU", "Sistema", "SSD")):
            m = Medidor(nombre)
            self.medidores[nombre] = m
            rej.addWidget(m, 0, col)
        raiz.addWidget(caja_temp)

        caja = QGroupBox("VENTILADORES Y ENERGIA")
        rej2 = QGridLayout(caja)
        self.lbl_fan = QLabel("--")
        self.lbl_bateria = QLabel("--")
        self.lbl_consumo = QLabel("--")
        self.lbl_cpu = QLabel("--")
        for r, (et, w) in enumerate((("Ventiladores", self.lbl_fan),
                                     ("Bateria", self.lbl_bateria),
                                     ("Consumo", self.lbl_consumo),
                                     ("CPU", self.lbl_cpu))):
            w.setObjectName("dato")
            rej2.addWidget(QLabel(et), r, 0)
            rej2.addWidget(w, r, 1)
        rej2.setColumnStretch(1, 1)
        raiz.addWidget(caja)
        raiz.addStretch()

    def refrescar(self):
        temps = hw.temperaturas()
        for nombre, m in self.medidores.items():
            m.set_valor(temps.get(nombre))
        rpm = hw.ventiladores_rpm()
        self.lbl_fan.setText("   ".join(f"{v} rpm" for v in rpm) if rpm
                             else "sin lectura")
        b = hw.bateria()
        self.lbl_bateria.setText(f"{b['capacidad']} %   {b['estado']}")
        c = b["consumo_mw"]
        self.lbl_consumo.setText(f"{c} mW" if c else
                                 "no medible (conectado a la red)")
        i = hw.cpu_info()
        self.lbl_cpu.setText(f"{i['mhz'] or '--'} MHz   gov {i['governor']}   "
                             f"EPP {i['epp'] or 'n/d'}   turbo {i['turbo']}")


class PaginaVentiladores(QWidget):
    def __init__(self):
        super().__init__()
        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
        raiz.setSpacing(12)
        t = QLabel("Ventiladores")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        caja_modo = QGroupBox("MODO")
        vm = QVBoxLayout(caja_modo)
        botones = QHBoxLayout()
        self.grupo = QButtonGroup(self)
        for i, nombre in enumerate(("Automatico (EC)", "Manual", "Curva")):
            b = QPushButton(nombre)
            b.setCheckable(True)
            self.grupo.addButton(b, i)
            botones.addWidget(b)
        self.grupo.button(0).setChecked(True)
        self.grupo.idClicked.connect(self._modo_cambiado)
        vm.addLayout(botones)

        self.lbl_rpm = QLabel("--")
        self.lbl_rpm.setObjectName("dato")
        vm.addLayout(fila("Velocidad real", self.lbl_rpm))
        aviso = QLabel(
            "El boton Turbo del portatil pone los ventiladores al maximo por "
            "su cuenta, saltandose este panel: lo gestiona el driver y su "
            "estado no se puede consultar, asi que si lo activas manda el.")
        aviso.setObjectName("pista")
        aviso.setWordWrap(True)
        vm.addWidget(aviso)
        raiz.addWidget(caja_modo)

        self.caja_manual = QGroupBox("VELOCIDAD MANUAL")
        vman = QVBoxLayout(self.caja_manual)
        self.sl_cpu = QSlider(Qt.Orientation.Horizontal)
        self.sl_gpu = QSlider(Qt.Orientation.Horizontal)
        self.lb_cpu = QLabel("0 %")
        self.lb_gpu = QLabel("0 %")
        self.lb_rpm_cpu = QLabel("-- rpm")
        self.lb_rpm_gpu = QLabel("-- rpm")
        for sl, lb, rpm, et in ((self.sl_cpu, self.lb_cpu, self.lb_rpm_cpu, "CPU"),
                                (self.sl_gpu, self.lb_gpu, self.lb_rpm_gpu, "GPU")):
            sl.setRange(0, 100)
            lb.setMinimumWidth(48)
            lb.setObjectName("dato")
            # El porcentaje es lo que se pide; las rpm son lo que el EC hace de
            # verdad. No siempre coinciden, asi que se muestran los dos.
            rpm.setMinimumWidth(78)
            rpm.setObjectName("dato")
            linea = QHBoxLayout()
            linea.addWidget(QLabel(et))
            linea.addWidget(sl, 1)
            linea.addWidget(lb)
            linea.addWidget(rpm)
            vman.addLayout(linea)
        self.sl_cpu.valueChanged.connect(lambda v: self.lb_cpu.setText(f"{v} %"))
        self.sl_gpu.valueChanged.connect(lambda v: self.lb_gpu.setText(f"{v} %"))
        self.sl_cpu.sliderReleased.connect(self._aplicar_manual)
        self.sl_gpu.sliderReleased.connect(self._aplicar_manual)
        raiz.addWidget(self.caja_manual)

        self.caja_curva = QGroupBox(
            "CURVA  ·  ARRASTRA LOS PUNTOS PARA FIJAR DESDE QUE TEMPERATURA "
            "GIRAN Y COMO ESCALAN")
        vc = QVBoxLayout(self.caja_curva)
        self.curva = EditorCurva()
        vc.addWidget(self.curva)
        pie = QHBoxLayout()
        self.lbl_curva = QLabel("--")
        self.lbl_curva.setObjectName("dato")
        pie.addWidget(self.lbl_curva, 1)
        b_guardar = QPushButton("Guardar como curva del sistema")
        b_guardar.clicked.connect(self._guardar_curva)
        pie.addWidget(b_guardar)
        vc.addLayout(pie)
        raiz.addWidget(self.caja_curva, 1)
        self._modo_cambiado(0)

    def _modo_cambiado(self, idx):
        self.caja_manual.setVisible(idx == 1)
        self.caja_curva.setVisible(idx == 2)
        if idx == 0:
            ok, err = hw.fan_auto()
            if not ok:
                QMessageBox.warning(self, "Ventiladores", err)

    def _aplicar_manual(self):
        ok, err = hw.fan_set(self.sl_cpu.value(), self.sl_gpu.value())
        if not ok:
            QMessageBox.warning(self, "Ventiladores", err)

    def _guardar_curva(self):
        puntos = sorted(self.curva.puntos)
        # El primer punto marca desde que temperatura giran: por debajo quedan
        # parados, que es justo lo que se busca para el silencio en reposo.
        t_min = puntos[0][0]
        curva = ",".join(f"{t}:{p}" for t, p in puntos[1:]) or f"{t_min + 10}:30"
        ok, err = hw.guardar_curva(t_min, curva)
        if ok:
            QMessageBox.information(
                self, "Curva de ventiladores",
                f"Guardada. Los ventiladores quedan parados por debajo de "
                f"{t_min} °C.\n\nPara que la aplique de forma continua:\n"
                "  sudo systemctl restart acer-powersave")
        else:
            QMessageBox.warning(self, "Curva de ventiladores",
                                err or "no se pudo guardar")

    def refrescar(self):
        rpm = hw.ventiladores_rpm()
        if rpm:
            self.lbl_rpm.setText("   ".join(f"{v} rpm" for v in rpm))
            self.lb_rpm_cpu.setText(f"{rpm[0]} rpm")
            if len(rpm) > 1:
                self.lb_rpm_gpu.setText(f"{rpm[1]} rpm")
        else:
            self.lbl_rpm.setText("sin lectura")

        estado = hw.fan_get()
        if estado and self.grupo.checkedId() != 1:
            for sl, v in ((self.sl_cpu, estado[0]), (self.sl_gpu, estado[1])):
                sl.blockSignals(True)
                sl.setValue(v)
                sl.blockSignals(False)
        t = hw.temperaturas().get("CPU")
        if t is not None:
            self.curva.set_temp_actual(t)
            if self.grupo.checkedId() == 2:
                pct = self.curva.porcentaje_para(t)
                self.lbl_curva.setText(f"a {t:.0f} °C la curva pide {pct} %")
                hw.fan_set(pct, pct)


class PaginaTeclado(QWidget):
    def __init__(self):
