        raiz.setSpacing(12)
        t = QLabel("Energia")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        caja_perf = QGroupBox("PERFIL DEL SISTEMA")
        v = QVBoxLayout(caja_perf)
        self.botones_perfil = QButtonGroup(self)
        linea = QHBoxLayout()
        for i, (clave, texto) in enumerate((("power-saver", "Ahorro"),
                                            ("balanced", "Equilibrado"),
                                            ("performance", "Rendimiento"))):
            b = QPushButton(texto)
            b.setCheckable(True)
            b.setProperty("perfil", clave)
            self.botones_perfil.addButton(b, i)
            linea.addWidget(b)
        self.botones_perfil.idClicked.connect(self._perfil)
        v.addLayout(linea)
        p = QLabel(
            "Es el perfil de power-profiles-daemon, el mismo que usa el applet "
            "de bateria de Plasma. A partir de el, el servicio acer-powersave "
            "ajusta la tasa de refresco, el EPP y el turbo.")
        p.setObjectName("pista")
        p.setWordWrap(True)
        v.addWidget(p)
        raiz.addWidget(caja_perf)

        caja_pant = QGroupBox("PANTALLA")
        vp = QVBoxLayout(caja_pant)
        self.cb_hz = QComboBox()
        self.cb_hz.activated.connect(self._refresco)
        vp.addLayout(fila("Tasa de refresco", self.cb_hz,
                          "Medido en este equipo: pasar de 144 a 60 Hz ahorra "
                          "unos 400 mW, el mayor ahorro individual."))
        raiz.addWidget(caja_pant)

        caja_gpu = QGroupBox("GPU DEDICADA")
        vg = QVBoxLayout(caja_gpu)
        self.lbl_gpu = QLabel("--")
        self.lbl_gpu.setObjectName("dato")
        vg.addLayout(fila("Estado", self.lbl_gpu))
        bg = QHBoxLayout()
        b_on = QPushButton("Encender")
        b_on.clicked.connect(lambda: self._gpu(True))
        b_off = QPushButton("Apagar")
        b_off.clicked.connect(lambda: self._gpu(False))
        bg.addWidget(b_on)
        bg.addWidget(b_off)
        bg.addStretch()
        vg.addLayout(bg)
        pg = QLabel(
            "Se enciende y se apaga en caliente, sin reiniciar: se retira del "
            "bus PCI y el puente cae a D3cold. El estado se lee solo por "
            "sysfs, porque lspci y nvidia-smi despiertan la tarjeta.")
        pg.setObjectName("pista")
        pg.setWordWrap(True)
        vg.addWidget(pg)
        raiz.addWidget(caja_gpu)
        raiz.addStretch()

    def _perfil(self, idx):
        b = self.botones_perfil.button(idx)
        ok, err = hw.perfil_set(b.property("perfil"))
        if not ok:
            QMessageBox.warning(self, "Perfil", err or "no se pudo cambiar")

    def _refresco(self):
        txt = self.cb_hz.currentText().replace(" Hz", "")
        if txt.isdigit():
            ok, err = hw.refresco_set(int(txt))
            if not ok:
                QMessageBox.warning(self, "Pantalla", err)

    def _gpu(self, encender):
        ok, err = hw.gpu_set(encender)
        if not ok:
            QMessageBox.warning(self, "GPU", err or "no se pudo cambiar")

    def refrescar(self):
        actual = hw.perfil_actual()
        for b in self.botones_perfil.buttons():
            b.setChecked(b.property("perfil") == actual)
        if self.cb_hz.count() == 0:
            for hz in hw.refrescos_disponibles():
                self.cb_hz.addItem(f"{hz} Hz")
        r = hw.refresco_actual()
        if r:
            i = self.cb_hz.findText(f"{r[1]} Hz")
            if i >= 0 and i != self.cb_hz.currentIndex():
                self.cb_hz.setCurrentIndex(i)
        self.lbl_gpu.setText(hw.gpu_estado())


class PaginaSistema(QWidget):
    def __init__(self):
        super().__init__()
        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
        raiz.setSpacing(12)
