        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
        raiz.setSpacing(12)
        t = QLabel("Retroiluminacion del teclado")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        nota = QLabel(
            "Aviso de este modelo: el primer campo que el driver llama «modo» "
            "es en realidad el interruptor de la luz, y el valor 0 apaga el "
            "teclado. Mientras esta apagado tampoco funcionan las teclas Fn de "
            "brillo, porque el EC solo las atiende con la luz encendida.")
        nota.setObjectName("pista")
        nota.setWordWrap(True)
        raiz.addWidget(nota)

        caja = QGroupBox("EFECTO")
        v = QVBoxLayout(caja)
        self.cb_efecto = QComboBox()
        for nombre, _ in hw.EFECTOS:
            self.cb_efecto.addItem(nombre)
        self.cb_efecto.setCurrentIndex(3)
        v.addLayout(fila("Efecto", self.cb_efecto))

        self.sl_brillo = QSlider(Qt.Orientation.Horizontal)
        self.sl_brillo.setRange(0, 100)
        self.sl_brillo.setValue(100)
        self.lb_brillo = QLabel("100 %")
        self.lb_brillo.setObjectName("dato")
        self.lb_brillo.setMinimumWidth(48)
        cont = QWidget()
        lb = QHBoxLayout(cont)
        lb.setContentsMargins(0, 0, 0, 0)
        lb.addWidget(self.sl_brillo, 1)
        lb.addWidget(self.lb_brillo)
        v.addLayout(fila("Brillo", cont))
        self.sl_brillo.valueChanged.connect(
            lambda x: self.lb_brillo.setText(f"{x} %"))

        self.sl_vel = QSlider(Qt.Orientation.Horizontal)
        self.sl_vel.setRange(0, 9)
        self.sl_vel.setValue(1)
        v.addLayout(fila("Velocidad", self.sl_vel,
                         "Solo afecta a los efectos animados."))

        self.b_color = QPushButton("Elegir color")
        self.b_color.clicked.connect(self._elegir_color)
        v.addLayout(fila("Color", self.b_color,
                         "Los efectos Neon y Parpadeo ignoran el color: lo "
                         "elige el firmware."))

        acciones = QHBoxLayout()
        b_aplicar = QPushButton("Aplicar")
        b_aplicar.clicked.connect(self._aplicar)
        b_apagar = QPushButton("Apagar")
        b_apagar.clicked.connect(self._apagar)
        acciones.addWidget(b_aplicar)
        acciones.addWidget(b_apagar)
        acciones.addStretch()
        v.addLayout(acciones)
        raiz.addWidget(caja)

        # --- color fijo por zona -------------------------------------------
        # El teclado tiene cuatro zonas. Esta es ademas la unica via para un
        # color estatico: el efecto "estatico" que numera el driver como 0 es
        # el mismo valor que apaga la luz.
        caja_z = QGroupBox("COLOR FIJO POR ZONA")
        vz = QVBoxLayout(caja_z)
        p_z = QLabel(
            "Cuatro zonas, de izquierda a derecha. Es la unica forma de tener "
            "un color estatico, porque el efecto «estatico» del driver comparte "
            "valor con el apagado.")
        p_z.setObjectName("pista")
        p_z.setWordWrap(True)
        vz.addWidget(p_z)

        self.colores_zona = [QColor("#00c8d7") for _ in range(4)]
        self.botones_zona = []
        linea_z = QHBoxLayout()
        for i in range(4):
            b = QPushButton(f"Zona {i + 1}")
            b.setMinimumHeight(52)
            b.clicked.connect(lambda _, idx=i: self._elegir_zona(idx))
            self.botones_zona.append(b)
            linea_z.addWidget(b)
        vz.addLayout(linea_z)

        self.sl_brillo_z = QSlider(Qt.Orientation.Horizontal)
        self.sl_brillo_z.setRange(0, 100)
        self.sl_brillo_z.setValue(100)
        self.lb_brillo_z = QLabel("100 %")
        self.lb_brillo_z.setObjectName("dato")
        self.lb_brillo_z.setMinimumWidth(48)
        cont_z = QWidget()
        lz = QHBoxLayout(cont_z)
        lz.setContentsMargins(0, 0, 0, 0)
        lz.addWidget(self.sl_brillo_z, 1)
        lz.addWidget(self.lb_brillo_z)
        vz.addLayout(fila("Brillo", cont_z))
        self.sl_brillo_z.valueChanged.connect(
            lambda x: self.lb_brillo_z.setText(f"{x} %"))

        acc_z = QHBoxLayout()
        b_apl_z = QPushButton("Aplicar colores por zona")
        b_apl_z.clicked.connect(self._aplicar_zonas)
        b_igual = QPushButton("Igualar las cuatro")
        b_igual.clicked.connect(self._igualar_zonas)
        acc_z.addWidget(b_apl_z)
        acc_z.addWidget(b_igual)
        acc_z.addStretch()
        vz.addLayout(acc_z)
        raiz.addWidget(caja_z)
        raiz.addStretch()
        self._pintar_boton()
        self._pintar_zonas()

    def _pintar_boton(self):
        self.b_color.setStyleSheet(
            f"background: {self.color.name()}; "
            f"color: {'#000' if self.color.lightness() > 127 else '#fff'};")

    def _elegir_color(self):
        c = QColorDialog.getColor(self.color, self, "Color del teclado")
        if c.isValid():
            self.color = c
            self._pintar_boton()

    def _aplicar(self):
        efecto = hw.EFECTOS[self.cb_efecto.currentIndex()][1]
        if efecto == 0:
            self._apagar()
            return
        ok, err = hw.kb_set(efecto, self.sl_vel.value(), self.sl_brillo.value(),
                            1, (self.color.red(), self.color.green(),
                                self.color.blue()))
        if not ok:
            QMessageBox.warning(self, "Teclado", err)

    def _apagar(self):
        ok, err = hw.kb_apagar()
        if not ok:
            QMessageBox.warning(self, "Teclado", err)

    def _pintar_zonas(self):
        for b, c in zip(self.botones_zona, self.colores_zona):
            b.setStyleSheet(
                f"background: {c.name()}; "
                f"color: {'#000' if c.lightness() > 127 else '#fff'};")

    def _elegir_zona(self, idx):
        c = QColorDialog.getColor(self.colores_zona[idx], self,
                                  f"Color de la zona {idx + 1}")
        if c.isValid():
            self.colores_zona[idx] = c
            self._pintar_zonas()
            self._aplicar_zonas()

    def _igualar_zonas(self):
        self.colores_zona = [QColor(self.colores_zona[0]) for _ in range(4)]
        self._pintar_zonas()
        self._aplicar_zonas()

    def _aplicar_zonas(self):
        colores = [f"{c.red():02x}{c.green():02x}{c.blue():02x}"
                   for c in self.colores_zona]
        ok, err = hw.kb_zonas_set(colores, self.sl_brillo_z.value())
        if not ok:
            QMessageBox.warning(self, "Teclado", err)

    def refrescar(self):
        est = hw.kb_get()
        if est and not self.sl_brillo.isSliderDown():
            self.sl_brillo.blockSignals(True)
            self.sl_brillo.setValue(est["brillo"])
            self.sl_brillo.blockSignals(False)
            self.lb_brillo.setText(f"{est['brillo']} %")

        zonas = hw.kb_zonas_get()
        if zonas and not self.sl_brillo_z.isSliderDown():
            colores, brillo = zonas
            for i, hexa in enumerate(colores[:4]):
                try:
                    self.colores_zona[i] = QColor("#" + hexa)
                except ValueError:
                    pass
            self._pintar_zonas()
            self.sl_brillo_z.blockSignals(True)
            self.sl_brillo_z.setValue(brillo)
            self.sl_brillo_z.blockSignals(False)
            self.lb_brillo_z.setText(f"{brillo} %")


