        t.setObjectName("titulo")
        raiz.addWidget(t)

        caja_bat = QGroupBox("BATERIA")
        v = QVBoxLayout(caja_bat)
        self.ch_limite = QCheckBox("Limitar la carga al 80 %")
        self.ch_limite.clicked.connect(
            lambda c: self._attr("battery_limiter", "1" if c else "0"))
        v.addWidget(self.ch_limite)
        p = QLabel(
            "El firmware solo admite este tope fijo: no se puede elegir otro "
            "porcentaje ni detener la carga a voluntad. Verificado leyendo el "
            "DSDT de este equipo.")
        p.setObjectName("pista")
        p.setWordWrap(True)
        v.addWidget(p)
        self.ch_calib = QCheckBox("Calibracion de bateria en curso")
        self.ch_calib.clicked.connect(
            lambda c: self._attr("battery_calibration", "1" if c else "0"))
        v.addWidget(self.ch_calib)
        p2 = QLabel(
            "Carga al 100 %, descarga a 0 % y vuelve a cargar. Tarda horas y "
            "no se debe desconectar el cargador durante el proceso.")
        p2.setObjectName("pista")
        p2.setWordWrap(True)
        v.addWidget(p2)
        raiz.addWidget(caja_bat)

        caja_sis = QGroupBox("FIRMWARE")
        vs = QVBoxLayout(caja_sis)
        self.cb_usb = QComboBox()
        for txt, val in (("Desactivado", "0"), ("Hasta el 10 %", "10"),
                         ("Hasta el 20 %", "20"), ("Hasta el 30 %", "30")):
            self.cb_usb.addItem(txt, val)
        self.cb_usb.activated.connect(
            lambda: self._attr("usb_charging", self.cb_usb.currentData()))
        vs.addLayout(fila("Carga USB apagado", self.cb_usb,
                          "Mantiene alimentado el puerto USB con el portatil "
                          "apagado hasta el nivel de bateria elegido."))
        self.ch_lcd = QCheckBox("LCD Override (reduce el ghosting)")
        self.ch_lcd.clicked.connect(
            lambda c: self._attr("lcd_override", "1" if c else "0"))
        vs.addWidget(self.ch_lcd)
        self.ch_boot = QCheckBox("Animacion y sonido de arranque")
        self.ch_boot.clicked.connect(
            lambda c: self._attr("boot_animation_sound", "1" if c else "0"))
        vs.addWidget(self.ch_boot)
        self.ch_timeout = QCheckBox(
            "Apagar la retroiluminacion tras 30 s de inactividad")
        self.ch_timeout.clicked.connect(
            lambda c: self._attr("backlight_timeout", "1" if c else "0"))
        vs.addWidget(self.ch_timeout)
        raiz.addWidget(caja_sis)
        raiz.addStretch()

    def _attr(self, nombre, valor):
        ok, err = hw.attr_set(nombre, valor)
        if not ok:
            QMessageBox.warning(self, "Ajuste", err)

    def refrescar(self):
        for chk, nombre in ((self.ch_limite, "battery_limiter"),
                            (self.ch_calib, "battery_calibration"),
                            (self.ch_lcd, "lcd_override"),
                            (self.ch_boot, "boot_animation_sound"),
                            (self.ch_timeout, "backlight_timeout")):
            estado = hw.attr_get(nombre) == "1"
            if chk.isChecked() != estado:
                chk.blockSignals(True)
                chk.setChecked(estado)
                chk.blockSignals(False)
        i = self.cb_usb.findData(hw.attr_get("usb_charging"))
        if i >= 0:
            self.cb_usb.setCurrentIndex(i)


class Ventana(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Acer Sense")
        self.setMinimumSize(920, 640)

        central = QWidget()
        self.setCentralWidget(central)
        raiz = QHBoxLayout(central)
        raiz.setContentsMargins(0, 0, 0, 0)
        raiz.setSpacing(0)

        lateral = QFrame()
        lateral.setObjectName("lateral")
        lateral.setFixedWidth(200)
        vl = QVBoxLayout(lateral)
        vl.setContentsMargins(0, 16, 0, 16)
        vl.setSpacing(2)

        marca = QLabel("  ACER SENSE")
        marca.setStyleSheet(
            f"color: {ACENTO.name()}; font-size: 12pt; font-weight: 700; "
            "letter-spacing: 2px; padding: 8px 16px 18px 16px;")
        vl.addWidget(marca)

        self.pila = QStackedWidget()
        paginas = [("Monitorizacion", PaginaMonitor()),
                   ("Ventiladores", PaginaVentiladores()),
                   ("Teclado", PaginaTeclado()),
                   ("Energia", PaginaEnergia()),
                   ("Bateria y sistema", PaginaSistema())]
        self.grupo_nav = QButtonGroup(self)
        for i, (nombre, pagina) in enumerate(paginas):
            b = QPushButton(nombre)
            b.setObjectName("nav")
            b.setCheckable(True)
            self.grupo_nav.addButton(b, i)
            vl.addWidget(b)
            self.pila.addWidget(pagina)
        self.grupo_nav.button(0).setChecked(True)
        self.grupo_nav.idClicked.connect(self.pila.setCurrentIndex)
        vl.addStretch()

        self.lbl_driver = QLabel()
        self.lbl_driver.setObjectName("pista")
        self.lbl_driver.setWordWrap(True)
        self.lbl_driver.setStyleSheet("padding: 8px 16px;")
        vl.addWidget(self.lbl_driver)

        raiz.addWidget(lateral)
        raiz.addWidget(self.pila, 1)

        self.temporizador = QTimer(self)
        self.temporizador.timeout.connect(self.refrescar)
        self.temporizador.start(2000)
        self.refrescar()

    def refrescar(self):
        if not hw.driver_presente():
            self.lbl_driver.setText(
                "El modulo linuwu_sense no esta cargado: la mayoria de los "
                "controles no funcionaran.")
        else:
            self.lbl_driver.setText(f"driver activo · {hw.panel().name}")
        # Solo se refresca la pagina visible: leer sysfs cuesta y algunas
        # lecturas despiertan al firmware.
        actual = self.pila.currentWidget()
        if hasattr(actual, "refrescar"):
            actual.refrescar()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Acer Sense")
    app.setDesktopFileName("acer-sense")
    # Sin esto Wayland pinta el icono generico en la barra de tareas.
    icono = QIcon.fromTheme("acer-sense")
    if icono.isNull():
        for ruta in ("/usr/share/icons/hicolor/scalable/apps/acer-sense.svg",
                     os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                  "acer-sense.svg")):
            if os.path.exists(ruta):
                icono = QIcon(ruta)
                break
    if not icono.isNull():
        app.setWindowIcon(icono)
    app.setStyleSheet(HOJA_ESTILO)

    if not hw.driver_presente():
        QMessageBox.warning(
            None, "Acer Sense",
            "No se encuentra el modulo linuwu_sense.\n\n"
            "Instala el paquete linuwu-sense-dkms y reinicia, o cargalo con:\n"
            "  sudo modprobe linuwu_sense")

    v = Ventana()
    v.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
