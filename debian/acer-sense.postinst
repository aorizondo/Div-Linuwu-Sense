#!/bin/sh
set -e

# La tecla dedicada del portatil emite el scancode 0xf5, que systemd mapea a
# "presentation": un nombre que ningun escritorio ofrece para asignar atajos.
# La regla hwdb de linuwu-sense-dkms lo remapea a KEY_PROG1, y el .desktop que
# instala este paquete declara X-KDE-Shortcuts=Launch (1), que es como KDE
# presenta ese keycode. No hace falta tocar nada del directorio del usuario.

case "$1" in
    configure)
        # La regla hwdb solo surte efecto tras reconstruir el indice binario.
        if command -v systemd-hwdb >/dev/null; then
            systemd-hwdb update || true
            udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
