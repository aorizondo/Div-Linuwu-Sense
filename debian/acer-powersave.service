[Unit]
Description=Ajustes de energia Acer segun el perfil de power-profiles-daemon
Documentation=https://github.com/aorizondo/Div-Linuwu-Sense
After=dbus.service power-profiles-daemon.service
Wants=power-profiles-daemon.service
# Sin PartOf: interesa seguir vivo aunque PPD se reinicie.

[Service]
Type=simple
ExecStart=/usr/bin/acer-powersave daemon
Restart=on-failure
RestartSec=5s

# Necesita escribir en sysfs y cargar y descargar modulos del kernel, asi que
# no puede encerrarse tanto como un servicio normal.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectProc=invisible
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/sys/devices /sys/bus /sys/module /sys/class

[Install]
WantedBy=multi-user.target
