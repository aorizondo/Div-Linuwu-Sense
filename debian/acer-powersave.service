[Unit]
Description=Ajustes de energia Acer segun el perfil de power-profiles-daemon
Documentation=https://github.com/aorizondo/Div-Linuwu-Sense
After=dbus.service power-profiles-daemon.service
# Sin Wants= a proposito: junto con After= formaba un ciclo de ordenacion que
# systemd rompia descartando el job de arranque, de modo que el servicio no
# llegaba a ejecutarse nunca.
#
# No hace falta: si PPD no esta, el daemon lo detecta (usa DO_NOT_AUTO_START)
# y sale; Restart=on-failure se encarga de reintentarlo.
#
# Sin PartOf: interesa seguir vivo aunque PPD se reinicie.

[Service]
Type=simple
ExecStart=/usr/bin/acer-powersave daemon
Restart=on-failure
RestartSec=5s

# Necesita escribir en sysfs y cargar y descargar modulos del kernel, asi que
# no puede encerrarse tanto como un servicio normal.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectProc=invisible
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# /etc/acer-powersave tiene que ser escribible: el servicio anota ahi el tope
# de carga cuando alguien lo cambia por su cuenta, porque el modulo no puede
# recordar un valor intermedio entre arranques. Con ProtectSystem=strict el
# resto de /etc sigue siendo de solo lectura.
ReadWritePaths=/sys/devices /sys/bus /sys/module /sys/class /etc/acer-powersave

[Install]
# graphical.target, NO multi-user.target, y el motivo es un ciclo de
# ordenacion que no se ve a simple vista:
#
#   power-profiles-daemon declara "After=multi-user.target display-manager.target"
#   y se instala en graphical.target.
#
# Con WantedBy=multi-user.target el grafo se cerraba sobre si mismo:
#
#   multi-user.target -(wants)-> acer-powersave      (y un target va DESPUES
#                                                     de lo que lo quiere)
#   acer-powersave    -(after)-> power-profiles-daemon
#   power-profiles-daemon -(after)-> multi-user.target
#
# systemd lo rompia descartando nuestro job ("Found ordering cycle on
# acer-powersave.service/start"), asi que el daemon NO arrancaba en el inicio;
# solo parecia funcionar porque dpkg lo levantaba al instalar el paquete, y el
# sintoma reaparecia en el siguiente reinicio.
#
# Un consumidor de PPD no puede vivir en un target anterior a PPD. En
# graphical.target el orden queda: multi-user -> PPD -> acer-powersave.
WantedBy=graphical.target
