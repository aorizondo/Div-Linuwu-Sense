#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""
acer-powersave - ajustes de energia para portatiles Acer Predator/Nitro.

Como servicio ("acer-powersave daemon") aplica los ajustes privilegiados que
corresponden al perfil activo de power-profiles-daemon. Como orden suelta
sirve para consultar el estado, medir consumo y encender o apagar la dGPU.

No guarda estado propio en ningun fichero: la propiedad ActiveProfile de PPD
es la unica fuente de verdad. En KDE, PowerDevil ya traduce AC/bateria a
perfil, asi que escuchar el perfil cubre tambien el enchufado y desenchufado
y ademas respeta la eleccion manual del usuario.

Lo que NO hace este servicio:
  - brillo de pantalla ni retroiluminacion del teclado (los lleva el usuario)
  - tasa de refresco: necesita la sesion Wayland, la aplica
    acer-powersave-session como servicio de usuario
"""

import configparser
import os
import struct
import subprocess
import sys
import threading
import time
from pathlib import Path

import gi
from gi.repository import Gio, GLib

PPD_NAME = "org.freedesktop.UPower.PowerProfiles"
PPD_PATH = "/org/freedesktop/UPower/PowerProfiles"
CONFIG = "/etc/acer-powersave/profiles.conf"

CPU = Path("/sys/devices/system/cpu")
PSTATE = CPU / "intel_pstate"
NVIDIA_ROOT_PORT = "0000:00:01.0"
NVIDIA_GPU = "0000:01:00.0"   # la funcion VGA
# Todas las funciones de la tarjeta, de mayor a menor: audio HDMI, USB-C xHCI
# y UCSI antes que la VGA. Mientras quede un hijo vivo colgando del puente, el
# puerto raiz no puede alcanzar D3cold, asi que hay que retirarlas todas.
NVIDIA_FUNCS = ("0000:01:00.3", "0000:01:00.2", "0000:01:00.1", "0000:01:00.0")
FAN_SYS = Path("/sys/module/linuwu_sense/drivers/platform:acer-wmi/acer-wmi"
               "/predator_sense/fan_speed")

# Retroiluminacion RGB de cuatro zonas. El formato de four_zone_mode es
# "modo,velocidad,brillo,rojo,verde,azul,direccion".
KB_MODE = Path("/sys/devices/platform/acer-wmi/four_zoned_kb/four_zone_mode")
KB_BRILLO_CAMPO = 2
# Escalones de brillo, apagado incluido. El 0 es el motivo de todo esto: el
# firmware no lo ofrece, da la vuelta al maximo.
#
# De 10 en 10: con saltos de 25 la escala entera eran cuatro pulsaciones y no
# habia forma de afinar. Once escalones se recorren igual de rapido dejando la
# tecla pulsada, porque el antirrebote de abajo limita el ritmo, no el numero.
KB_NIVELES = tuple(range(0, 101, 10))
# Scancodes que emite el teclado AT para Fn+F10 y Fn+F9. Se escuchan en crudo
# en vez de mapearlos a KEY_KBDILLUMUP/DOWN a proposito: mapearlos meteria a
# KDE en la ecuacion (intentaria gobernar un /sys/class/leds/*kbd_backlight*
# que en este equipo NO EXISTE) y ya hay dos sistemas de sobra en juego.
KB_SCAN_SUBIR = 0xEF
KB_SCAN_BAJAR = 0xF0
# Dos pulsaciones mas juntas que esto son autorepeat del firmware, no
# intencion del usuario. Sin este filtro, mantener la tecla barre la escala
# entera en medio segundo.
KB_ANTIREBOTE = 0.25


def log(msg):
    print(msg, flush=True)


def write_sysfs(path, value):
    """Escribe en sysfs solo si existe y es escribible. Nunca lanza."""
    try:
        p = Path(path)
        if not p.exists():
            return False
        if not os.access(p, os.W_OK):
            log(f"  aviso: {path} no es escribible")
            return False
        p.write_text(str(value))
        return True
    except OSError as e:
        log(f"  aviso: no se pudo escribir {path}: {e}")
        return False


def write_all(pattern, value):
    n = 0
    for p in CPU.glob(pattern):
        if write_sysfs(p, value):
            n += 1
    return n


def read_first(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


# --------------------------------------------------------------------------
#  Retroiluminacion del teclado
# --------------------------------------------------------------------------
#
# El problema que resuelve esto: en este equipo hay DOS sistemas tocando el
# brillo del teclado y no se hablan entre ellos.
#
#   - El EC (firmware) reacciona a Fn+F9/F10 por su cuenta, sin pasar por
#     Linux, y al llegar al minimo da la vuelta al MAXIMO en vez de apagar.
#   - linuwu_sense mantiene su propio estado, que nunca se sincroniza con el
#     EC: comprobado pulsando la tecla unas 40 veces seguidas, con el brillo
#     real cambiando a la vista, mientras four_zone_mode seguia clavado en
#     "2,0,80,0,0,0,0" de principio a fin.
#
# No se puede impedir que el EC actue, pero si corregirlo despues: los
# scancodes SI llegan a /dev/input, y escribir four_zone_mode tiene la ultima
# palabra sobre el hardware (verificado: apagado, maximo, apagado y medio,
# obedecidos los cuatro). Asi que se escucha la tecla, se lleva la cuenta del
# nivel aqui y se reescribe el brillo detras del EC.
#
# El efecto util es el escalon que faltaba: el 0. Bajando se llega a apagado y
# ahi se queda, en lugar de saltar al maximo.

def _teclado_at():
    """Ruta del evdev del teclado interno, o None.

    Se busca por nombre en vez de fijar /dev/input/event0 porque la
    numeracion depende del orden de enumeracion y puede cambiar."""
    try:
        bloques = Path("/proc/bus/input/devices").read_text().split("\n\n")
    except OSError:
        return None
    for b in bloques:
        if 'Name="AT Translated Set 2 keyboard"' not in b:
            continue
        for palabra in b.split():
            if palabra.startswith("event"):
                return Path("/dev/input") / palabra
    return None


def _kb_campos():
    """four_zone_mode como lista de enteros, o None si no se puede leer."""
    try:
        return [int(x) for x in KB_MODE.read_text().strip().split(",")]
    except (OSError, ValueError):
        return None


def _kb_poner_brillo(nivel):
    campos = _kb_campos()
    if campos is None or len(campos) <= KB_BRILLO_CAMPO:
        return False
    campos[KB_BRILLO_CAMPO] = nivel
    return write_sysfs(KB_MODE, ",".join(str(c) for c in campos))


def _kb_nivel_mas_cercano(valor):
    """El escalon al que corresponde un brillo cualquiera.

    Hace falta porque el punto de partida no tiene por que ser uno de los
    nuestros: puede venir del EC, de la interfaz grafica o del estado que el
    driver restaura al cargarse."""
    return min(range(len(KB_NIVELES)),
               key=lambda i: abs(KB_NIVELES[i] - valor))


def escuchar_backlight_teclado():
    """Bucle que corrige el brillo del teclado por detras del EC.

    Pensado para vivir en un hilo daemon: si algo falla se registra y se
    abandona la vigilancia, sin tumbar el servicio."""
    dispositivo = _teclado_at()
    if dispositivo is None or not dispositivo.exists():
        log("backlight del teclado: no se encontro el teclado interno")
        return
    campos = _kb_campos()
    if campos is None:
        log("backlight del teclado: four_zone_mode no disponible, sin vigilancia")
        return

    indice = _kb_nivel_mas_cercano(campos[KB_BRILLO_CAMPO])
    log(f"backlight del teclado: vigilando {dispositivo}, "
        f"nivel inicial {KB_NIVELES[indice]}%")

    # struct input_event: dos campos de tiempo del tamano de un long, y
    # despues tipo, codigo y valor.
    FORMATO = "llHHi"
    TAM = struct.calcsize(FORMATO)
    EV_MSC, MSC_SCAN = 0x04, 0x04
    ultima = 0.0

    try:
        with open(dispositivo, "rb", buffering=0) as f:
            while True:
                datos = f.read(TAM)
                if not datos or len(datos) < TAM:
                    break
                _, _, tipo, codigo, valor = struct.unpack(FORMATO, datos)
                if tipo != EV_MSC or codigo != MSC_SCAN:
                    continue
                if valor not in (KB_SCAN_SUBIR, KB_SCAN_BAJAR):
                    continue

                ahora = time.monotonic()
                if ahora - ultima < KB_ANTIREBOTE:
                    continue
                ultima = ahora

                if valor == KB_SCAN_BAJAR:
                    # Sin dar la vuelta: abajo del todo es apagado, y ahi se
                    # queda. Es justo lo que el firmware se niega a hacer.
                    indice = max(0, indice - 1)
                else:
                    indice = min(len(KB_NIVELES) - 1, indice + 1)

                # El EC ya ha aplicado lo suyo cuando llegamos aqui; esta
                # escritura va detras, y es la que se queda.
                _kb_poner_brillo(KB_NIVELES[indice])
    except OSError as e:
        log(f"backlight del teclado: se abandona la vigilancia ({e})")


# --------------------------------------------------------------------------
#  dGPU: encendido y apagado en caliente, sin reiniciar
# --------------------------------------------------------------------------

def gpu_present():
    return Path(f"/sys/bus/pci/devices/{NVIDIA_GPU}").exists()


def gpu_in_use():
    """Devuelve el motivo por el que no se puede apagar, o None si esta libre.

    El refcount de los modulos NO sirve como criterio: con modeset=1,
    nvidia_drm arrastra un refcount de 1 permanente aunque no la use nadie, y
    los modulos se referencian entre si. Lo que de verdad indica uso son los
    ficheros de dispositivo abiertos, que es lo que impide descargarlos."""
    abiertos = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            for fd in (proc / "fd").iterdir():
                destino = os.readlink(fd)
                if destino.startswith("/dev/nvidia"):
                    nombre = (proc / "comm").read_text().strip()
                    abiertos.append(f"{nombre} (pid {proc.name})")
                    break
        except OSError:
            continue        # el proceso murio o no es nuestro: se ignora

    if abiertos:
        return "lo estan usando: " + ", ".join(sorted(set(abiertos))[:5])

    # nvidia_uvm con refcount propio significa CUDA en marcha, y eso si bloquea.
    uvm = read_first("/sys/module/nvidia_uvm/refcnt")
    if uvm and uvm not in ("0", ""):
        return f"hay trabajo CUDA en curso (nvidia_uvm refcount {uvm})"
    return None


def gpu_off():
    """Descarga los modulos, quita la GPU del bus y deja que el puente caiga
    a D3cold. Es lo mismo que hace envycontrol via udev, pero en caliente."""
    if not gpu_present():
        log("  dGPU: ya estaba fuera del bus")
        write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power/control", "auto")
        return True

    motivo = gpu_in_use()
    if motivo:
        log(f"  dGPU: no se apaga, {motivo}")
        return False

    # El orden importa: al reves deja referencias colgando y falla.
    for mod in ("nvidia_drm", "nvidia_modeset", "nvidia_uvm", "nvidia"):
        subprocess.run(["modprobe", "-r", mod],
                       capture_output=True, check=False)

    # Hay que retirar TODAS las funciones; si queda un hijo vivo el puente
    # nunca llega a D3cold.
    for func in NVIDIA_FUNCS:
        write_sysfs(f"/sys/bus/pci/devices/{func}/remove", "1")

    write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power/control", "auto")
    time.sleep(2)
    estado = read_first(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power_state")
    log(f"  dGPU: apagada (puente en {estado})")
    return True


def gpu_on():
    """Reescanea el bridge y carga el driver. En Debian el modulo se llama
    nvidia-current, no nvidia."""
    if gpu_present():
        log("  dGPU: ya presente")
        return True

    write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power/control", "on")
    # Reescanear el bridge, no el bus entero: menos efectos colaterales.
    write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/rescan", "1")

    # Salir de D3cold y reenumerar tarda, y cuanto tarda depende del equipo:
    # una espera fija se queda corta y hace reportar un fallo que no existe.
    # Se sondea hasta 20 s y se sale en cuanto aparece.
    espera = 0.0
    while espera < 20.0:
        if gpu_present():
            break
        time.sleep(0.5)
        espera += 0.5

    if not gpu_present():
        log(f"  dGPU: no aparecio en el bus tras {espera:.0f} s de espera")
        return False
    log(f"  dGPU: presente en el bus tras {espera:.1f} s")

    # Se carga el modulo DRM y no el base: arrastra a los otros tres como
    # dependencias y es el unico al que tiene sentido pasarle modeset.
    #
    # modeset=1 va en la linea de ordenes a proposito, no en modprobe.d. El
    # nombre que indexa modprobe en Debian es el del fichero
    # (nvidia-current-drm), pero las herramientas al uso escriben
    # "options nvidia-drm ...", que es el nombre INTERNO del modulo, y la
    # opcion se pierde sin dar ningun error: el sintoma es que
    # /sys/module/nvidia_drm/parameters/modeset se queda en N. Pasandolo aqui
    # no hay ambiguedad posible.
    #
    # Sin modeset no hay conectores de video, y en este equipo el HDMI cuelga
    # de la dGPU, no de la Intel.
    for name in ("nvidia-current-drm", "nvidia-drm"):
        r = subprocess.run(["modprobe", name, "modeset=1"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            log(f"  dGPU: encendida, modulo {name} cargado con modeset=1")
            break
    else:
        log("  dGPU: presente en el bus pero no se pudo cargar el driver")

    # Runtime PM en la GPU, no solo en el puente: sin esto el kernel la deja
    # en "on" y nunca suspende, quedandose en D0 a 7-10 W aunque no se use.
    write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_GPU}/power/control", "auto")
    write_sysfs(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power/control", "auto")
    return True


# --------------------------------------------------------------------------
#  Aplicacion de un perfil
# --------------------------------------------------------------------------

def opcion(cfg, seccion, clave, clave_antigua=None, **kw):
    """Lee una clave de configuracion aceptando tambien su nombre anterior.

    Los nombres pasaron de castellano a ingles cuando el paquete se preparo
    para publicarse. Un profiles.conf antiguo es un fichero de configuracion
    del usuario: dpkg lo conserva, asi que hay que seguir entendiendolo.
    """
    tipo = kw.pop("tipo", "str")
    lector = {"str": cfg.get, "int": cfg.getint, "bool": cfg.getboolean}[tipo]
    for sec in (seccion, kw.pop("seccion_antigua", None)):
        if not sec or not cfg.has_section(sec):
            continue
        for k in (clave, clave_antigua):
            if k and cfg.has_option(sec, k):
                return lector(sec, k)
    return kw.get("fallback")


def leer_config():
    cp = configparser.ConfigParser()
    cp.read(CONFIG)
    return cp


# Lo pone cmd_daemon(). Fuera del servicio no hay bucle de GLib al que
# encolar nada, y programar un timeout seria un error silencioso.
_en_daemon = False


def liberar_frecuencia_si_clavada():
    """Deshace el recorte de frecuencia que deja PPD en power-saver.

    power-profiles-daemon 0.30, con CpuDriver intel_pstate, implementa su
    perfil de ahorro fijando scaling_max_freq al MINIMO del hardware, ademas
    de poner el EPP. Comprobado parando este servicio y haciendo la transicion
    a mano: balanced deja max=5000000 y power-saver lo baja a 800000.

    En este equipo eso sale caro: medido, la CPU tarda 3,25 veces mas en la
    misma tarea y gasta 3,3 veces mas energia, porque pasa mucho menos tiempo
    en reposo profundo. El EPP por si solo ya mantiene las frecuencias bajas
    cuando no hay trabajo, que es lo que se quiere; el tope rigido solo impide
    despachar rapido y volver a dormir.

    Se reconoce por min == max: ningun ajuste legitimo deja los dos limites
    pegados, asi que fuera de ese caso no se toca nada.

    Devuelve False siempre, para que GLib no repita el temporizador.
    """
    cur_min = read_first(CPU / "cpu0/cpufreq/scaling_min_freq")
    cur_max = read_first(CPU / "cpu0/cpufreq/scaling_max_freq")
    hw_min = read_first(CPU / "cpu0/cpufreq/cpuinfo_min_freq")
    hw_max = read_first(CPU / "cpu0/cpufreq/cpuinfo_max_freq")

    if cur_min and cur_max and cur_min == cur_max and hw_min and hw_max:
        log(f"  frecuencia clavada en {cur_min} kHz, liberando a {hw_min}-{hw_max}")
        write_all("cpu*/cpufreq/scaling_max_freq", hw_max)
        write_all("cpu*/cpufreq/scaling_min_freq", hw_min)
    return False


def aplicar(perfil, cfg):
    if not cfg.has_section(perfil):
        log(f"perfil '{perfil}' sin seccion en {CONFIG}, se ignora")
        return

    s = cfg[perfil]
    log(f"perfil -> {perfil}")

    # --- CPU -------------------------------------------------------------
    # Con intel_pstate en modo activo el governor debe quedarse en powersave
    # y quien manda es el EPP. En modo passive manda el governor.
    # El turbo va PRIMERO: activarlo o desactivarlo cambia cpuinfo_max_freq
    # (2,6 GHz sin turbo, 5,0 GHz con turbo), asi que fijar la frecuencia antes
    # dejaria un limite calculado sobre un rango que deja de ser valido.
    # "cpu_turbo" es Intel Turbo Boost, NO el boton Turbo del Predator (ese lo
    # gestiona linuwu_sense por su cuenta). Se acepta "turbo" como alias por
    # compatibilidad con configuraciones antiguas.
    turbo = s.get("cpu_turbo", s.get("turbo", "")).strip()
    if turbo in ("on", "off"):
        write_sysfs(PSTATE / "no_turbo", "0" if turbo == "on" else "1")

    # Devolver los limites de frecuencia al rango del hardware. Sin esto, si
    # otra herramienta los dejo clavados (el RunScript de PowerDevil con
    # "cpupower --min 800 --max 800" es el caso tipico) el estado sobrevive
    # indefinidamente y el EPP no puede hacer nada.
    #
    # Salvo en modo passive: ahi PPD no puede usar el EPP (necesita HWP, que
    # solo existe en modo activo) e implementa power-saver recortando el
    # scaling_max_freq. Escribirlo nosotros seria pelearnos con el por el mismo
    # fichero, y gana quien escriba el ultimo. En modo activo PPD usa el EPP y
    # deja la frecuencia en paz, asi que ahi si conviene normalizarla.
    # La frecuencia la gestiona PPD en los dos modos: recortando scaling_max_freq
    # en passive, y via EPP en activo. Escribirla sin motivo es pelearse con el
    # por el mismo fichero, y ademas intel_pstate devuelve EBUSY en varias CPUs
    # cuando el governor esta en "performance".
    #
    # La unica situacion que justifica intervenir es encontrarla CLAVADA
    # (min == max), senal inequivoca de que otra herramienta la fijo a mano --el
    # caso tipico era el RunScript de PowerDevil con "cpupower --min 800
    # --max 800"-- porque ese estado sobrevive indefinidamente y deja al EPP sin
    # margen. Fuera de ese caso no se toca.
    pstate_mode = read_first(PSTATE / "status")
    cur_min = read_first(CPU / "cpu0/cpufreq/scaling_min_freq")
    cur_max = read_first(CPU / "cpu0/cpufreq/scaling_max_freq")
    hw_min = read_first(CPU / "cpu0/cpufreq/cpuinfo_min_freq")
    hw_max = read_first(CPU / "cpu0/cpufreq/cpuinfo_max_freq")

    if s.getboolean("unpin_cpu_freq",
                    fallback=s.getboolean("liberar_frecuencia", fallback=True)):
        liberar_frecuencia_si_clavada()
        # Y otra vez mas tarde, porque aqui llegamos DEMASIADO PRONTO.
        #
        # PPD emite PropertiesChanged y sigue escribiendo despues: cuando esta
        # llamada lee scaling_max_freq, el recorte todavia no esta puesto y no
        # hay nada que deshacer. El sintoma era exacto: el log decia "perfil ->
        # power-saver" sin la linea de "frecuencia clavada", y la CPU se
        # quedaba a 800 MHz igualmente.
        #
        # Dos reintentos en vez de uno: no hay forma de saber cuanto tarda PPD
        # y reintentar es barato (leer cuatro ficheros de sysfs).
        if _en_daemon:
            for retardo in (2, 6):
                GLib.timeout_add_seconds(retardo, liberar_frecuencia_si_clavada)

    # En modo ACTIVO, PPD implementa sus perfiles justamente con el governor y
    # el EPP, asi que tocarlos aqui es pelearse con el por el mismo fichero.
    # Ademas intel_pstate bloquea el EPP (EBUSY) cuando el governor esta en
    # "performance", que es lo que PPD pone para su perfil de rendimiento.
    #
    # En modo passive ocurre al reves: el EPP no existe como palanca real y
    # manda el governor, que ahi si conviene fijar.
    if pstate_mode == "active":
        log("  cpu: governor y EPP los gestiona PPD (intel_pstate activo)")
    else:
        gov = s.get("governor", "").strip()
        if gov:
            write_all("cpu*/cpufreq/scaling_governor", gov)
        epp = s.get("epp", "").strip()
        if epp:
            write_all("cpu*/cpufreq/energy_performance_preference", epp)

    # --- dGPU ------------------------------------------------------------
    gpu = s.get("dgpu", "").strip()
    if gpu == "off":
        gpu_off()
    elif gpu == "on":
        gpu_on()

    # --- Ethernet --------------------------------------------------------
    # Sin efecto medible en consumo, pero descargarla evita que el PHY quede
    # alimentado sin enlace. Solo si no hay cable.
    eth = s.get("ethernet", "").strip()
    if eth == "off" and read_first("/sys/class/net/eth0/carrier", "0") == "0":
        subprocess.run(["modprobe", "-r", "r8169"],
                       capture_output=True, check=False)
    elif eth == "on":
        subprocess.run(["modprobe", "r8169"], capture_output=True, check=False)

    # --- Ventiladores ----------------------------------------------------
    # Por defecto no se tocan los ventiladores: el boton Turbo los pone al
    # maximo y su estado no es consultable desde sysfs, de modo que escribir
    # fan_speed en cada cambio de perfil cancelaria el turbo sin querer.
    fan = s.get("fan", "keep").strip()
    if fan and fan != "keep" and FAN_SYS.exists():
        if fan == "auto":
            write_sysfs(FAN_SYS, "0,0")
        elif fan.isdigit():
            write_sysfs(FAN_SYS, f"{fan},{fan}")

    # --- Periferia -------------------------------------------------------
    if s.getboolean("runtime_pm", fallback=True):
        for p in Path("/sys/bus/pci/devices").glob("*/power/control"):
            write_sysfs(p, "auto")
        for d in Path("/sys/bus/usb/devices").glob("*/"):
            # El raton se excluye a proposito: autosuspenderlo da tirones.
            if d.name in excluir_usb:
                continue
            write_sysfs(d / "power/control", "auto")

    if s.get("audio_powersave", "").strip():
        write_sysfs("/sys/module/snd_hda_intel/parameters/power_save",
                    s.get("audio_powersave"))


# --------------------------------------------------------------------------
#  Bucle principal
# --------------------------------------------------------------------------

excluir_usb = set()


def cargar_excluir(cfg):
    global excluir_usb
    excluir_usb = {x.strip() for x in
                   (opcion(cfg, "general", "exclude_usb", "excluir_usb",
                           fallback="") or "").split(",")
                   if x.strip()}


def potencia_mw():
    """Consumo instantaneo. No existe power_now en este equipo, se calcula."""
    i = read_first("/sys/class/power_supply/BAT1/current_now")
    v = read_first("/sys/class/power_supply/BAT1/voltage_now")
    if not i or not v:
        return None
    return (int(i) // 1000) * (int(v) // 1000) // 1000


def cmd_daemon(_args):
    global _en_daemon
    _en_daemon = True

    cfg = leer_config()
    cargar_excluir(cfg)

    # La retroiluminacion del teclado no tiene nada que ver con el perfil de
    # energia, asi que se vigila en su propio hilo en vez de meterla en el
    # bucle de D-Bus. Es un hilo daemon: no impide que el servicio termine.
    threading.Thread(target=escuchar_backlight_teclado,
                     name="backlight-teclado", daemon=True).start()

    try:
        proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM,
            # No arrancar PPD si esta parado: si no esta, no hay nada que seguir.
            Gio.DBusProxyFlags.DO_NOT_AUTO_START,
            None, PPD_NAME, PPD_PATH, PPD_NAME, None)
    except GLib.Error as e:
        log(f"no se pudo hablar con power-profiles-daemon: {e}")
        return 1

    def on_props(_proxy, changed, _invalidated):
        if "ActiveProfile" in changed.keys():
            c = leer_config()
            cargar_excluir(c)
            aplicar(changed["ActiveProfile"], c)

    proxy.connect("g-properties-changed", on_props)

    # Estado inicial: nunca confiar solo en la senal, puede no llegar nunca.
    actual = proxy.get_cached_property("ActiveProfile")
    if actual is None:
        log("PPD no reporta ActiveProfile; saliendo")
        return 1
    aplicar(actual.get_string(), cfg)

    GLib.MainLoop().run()
    return 0


def perfil_activo():
    try:
        r = subprocess.run(["powerprofilesctl", "get"],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or "?"
    except (OSError, subprocess.SubprocessError):
        return "?"


def cmd_status(_args):
    p = potencia_mw()
    bat = read_first("/sys/class/power_supply/BAT1/capacity")
    est = read_first("/sys/class/power_supply/BAT1/status")
    print(f"{'consumo':<16} {p if p is not None else '?'} mW  ({est}, {bat}%)")
    print(f"{'perfil PPD':<16} {perfil_activo()}")
    print(f"{'governor':<16} {read_first(CPU / 'cpu0/cpufreq/scaling_governor')}")
    print(f"{'epp':<16} {read_first(CPU / 'cpu0/cpufreq/energy_performance_preference')}")
    print(f"{'frecuencia':<16} {read_first(CPU / 'cpu0/cpufreq/scaling_min_freq')}"
          f"-{read_first(CPU / 'cpu0/cpufreq/scaling_max_freq')} kHz")
    turbo = read_first(PSTATE / "no_turbo")
    print(f"{'turbo':<16} {'off' if turbo == '1' else 'on'}")
    print(f"{'pstate':<16} {read_first(PSTATE / 'status')}")
    aspm = read_first("/sys/module/pcie_aspm/parameters/policy")
    print(f"{'aspm':<16} {aspm[aspm.find('[') + 1:aspm.find(']')] if '[' in aspm else aspm}")
    # Solo sysfs: lspci y nvidia-smi DESPIERTAN el puente y falsean la lectura.
    if gpu_present():
        print(f"{'dGPU':<16} presente en el bus")
    else:
        est_pt = read_first(f"/sys/bus/pci/devices/{NVIDIA_ROOT_PORT}/power_state")
        print(f"{'dGPU':<16} fuera del bus (puente en {est_pt})")
    print(f"{'ventilador':<16} "
          f"{read_first(FAN_SYS) if FAN_SYS.exists() else 'sin control (falta linuwu_sense)'}")
    return 0


def cmd_medir(args):
    """Mediana de muestras en reposo. Descarta las muestras con la CPU
    ocupada, para que comparar dos configuraciones tenga sentido."""
    dur, umbral = getattr(args, 'seconds', getattr(args, 'segundos', 30)), 12
    muestras, descartadas = [], 0

    def cpu_tick():
        campos = Path("/proc/stat").read_text().split("\n")[0].split()[1:]
        nums = [int(x) for x in campos]
        return sum(nums), nums[3] + nums[4]

    tot0, idle0 = cpu_tick()
    fin = time.monotonic() + dur
    while time.monotonic() < fin:
        time.sleep(2)
        tot1, idle1 = cpu_tick()
        dt, di = tot1 - tot0, idle1 - idle0
        ocupada = 100 * (dt - di) // dt if dt else 0
        tot0, idle0 = tot1, idle1
        p = potencia_mw()
        if p is None:
            continue
        if ocupada > umbral:
            descartadas += 1
            continue
        muestras.append(p)

    if len(muestras) < 3:
        print(f"muestras insuficientes ({len(muestras)}); "
              f"{descartadas} descartadas por actividad")
        return 1
    muestras.sort()
    print(f"consumo mediano: {muestras[len(muestras) // 2]} mW   "
          f"(n={len(muestras)}, {descartadas} descartadas, "
          f"rango {muestras[0]}-{muestras[-1]})")
    return 0


def cmd_gpu(args):
    if os.geteuid() != 0:
        print("gpu on|off requiere root")
        return 1
    return 0 if (gpu_on() if args.estado == "on" else gpu_off()) else 1


def cmd_fan(args):
    """Curva de ventiladores. El sysfs de linuwu_sense solo acepta 0 (curva
    del EC) o un porcentaje fijo, asi que la curva se implementa aqui."""
    if not FAN_SYS.exists():
        print("no hay control de ventiladores: falta el modulo linuwu_sense")
        return 1
    if os.geteuid() != 0:
        print("fan requiere root")
        return 1

    cfg = leer_config()
    t0 = opcion(cfg, "fans", "min_temp", "temp_minima",
                tipo="int", seccion_antigua="ventiladores", fallback=40)
    hist = opcion(cfg, "fans", "hysteresis", "histeresis",
                  tipo="int", seccion_antigua="ventiladores", fallback=3)
    curva = []
    for par in opcion(cfg, "fans", "curve", "curva",
                      seccion_antigua="ventiladores",
                      fallback="50:20,60:35,70:55,80:75,99:100").split(","):
        lim, pct = par.split(":")
        curva.append((int(lim), int(pct)))
    curva.sort()

    def pct_para(t):
        if t < t0:
            return 0
        for lim, pct in curva:
            if t < lim:
                return pct
        return 100

    print(f"curva activa: parados por debajo de {t0} C. Ctrl-C para salir.")
    anterior = -1
    try:
        while True:
            t = int(read_first("/sys/class/thermal/thermal_zone0/temp", "0")) // 1000
            pct = pct_para(t)
            # Histeresis: para bajar de escalon exige margen, si no oscila.
            if anterior >= 0 and pct < anterior and pct_para(t + hist) >= anterior:
                pct = anterior
            if pct != anterior:
                write_sysfs(FAN_SYS, f"{pct},{pct}")
                print(f"{t} C -> ventiladores {pct} %")
                anterior = pct
            time.sleep(5)
    except KeyboardInterrupt:
        write_sysfs(FAN_SYS, "0,0")
        print("\ndevuelto al control automatico del EC")
    return 0


def cmd_guardar_curva(args):
    """Escribe la curva en la configuracion. Lo invoca la interfaz por pkexec."""
    if os.geteuid() != 0:
        print("guardar-curva requiere root")
        return 1
    import configparser
    cp = configparser.ConfigParser()
    cp.read(CONFIG)
    if not cp.has_section("fans"):
        cp.add_section("fans")
    cp.set("fans", "min_temp", str(args.temp_minima))
    cp.set("fans", "curve", args.curva)
    # Si venia de una version anterior, la seccion antigua se queda con los
    # valores viejos y ganaria en la siguiente lectura. Se retira.
    if cp.has_section("ventiladores"):
        cp.remove_section("ventiladores")
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w") as f:
            cp.write(f)
    except OSError as e:
        print(f"no se pudo escribir {CONFIG}: {e}")
        return 1
    print(f"curva guardada: parados por debajo de {args.temp_minima} C, "
          f"escalado {args.curva}")
    return 0


def main():
    import argparse
    ap = argparse.ArgumentParser(
        prog="acer-powersave",
        description="Hardware and power management for Acer Predator/Nitro")
    sub = ap.add_subparsers(dest="cmd", required=True)

    # Los nombres en castellano se conservan como alias: la version anterior
    # los usaba, y la accion de polkit y cualquier script del usuario los
    # invocan por su nombre. Romperlos por una traduccion seria gratuito.
    sub.add_parser("daemon", help="follow the power-profiles-daemon profile")
    sub.add_parser("status", help="current state of the system")
    m = sub.add_parser("measure", aliases=["medir"],
                       help="median idle power draw")
    m.add_argument("seconds", nargs="?", type=int, default=30)
    g = sub.add_parser("gpu", help="power the discrete GPU up or down")
    g.add_argument("estado", choices=["on", "off"], metavar="on|off")
    sub.add_parser("fan", help="apply the fan curve")
    gc = sub.add_parser("save-curve", aliases=["guardar-curva"],
                        help="write the fan curve to the configuration")
    gc.add_argument("temp_minima", type=int, metavar="MIN_TEMP")
    gc.add_argument("curva", metavar="CURVE",
                    help="temperature:percentage pairs, comma separated")

    args = ap.parse_args()
    ordenes = {
        "daemon": cmd_daemon, "status": cmd_status,
        "measure": cmd_medir, "medir": cmd_medir,
        "gpu": cmd_gpu, "fan": cmd_fan,
        "save-curve": cmd_guardar_curva, "guardar-curva": cmd_guardar_curva,
    }
    return ordenes[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
