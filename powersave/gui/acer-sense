class PaginaMonitor(QWidget):
    def __init__(self):
        super().__init__()
        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 16)
        raiz.setSpacing(14)
        t = QLabel("Monitorización")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        caja_temp = QGroupBox("TEMPERATURAS")
        # Los medidores se crean segun lo que el equipo publique de verdad: no
        # todos tienen los mismos sensores (el disco mecanico solo aparece con
        # el modulo drivetemp, y la GPU dedicada solo cuando esta encendida).
        self.rej_temp = QGridLayout(caja_temp)
        self.medidores = {}
        raiz.addWidget(caja_temp)

        caja_fan = QGroupBox("VENTILADORES")
        hf = QHBoxLayout(caja_fan)
        self.fan_cpu = Ventilador("CPU")
        self.fan_gpu = Ventilador("GPU")
        hf.addStretch()
        hf.addWidget(self.fan_cpu)
        hf.addSpacing(30)
        hf.addWidget(self.fan_gpu)
        hf.addStretch()
        raiz.addWidget(caja_fan)

        caja_sis = QGroupBox("SISTEMA")
        hs = QHBoxLayout(caja_sis)
        hs.setSpacing(12)
        self.t_bateria = Tarjeta("Batería")
        self.t_consumo = Tarjeta("Consumo")
        self.t_cpu = Tarjeta("CPU")
        for w in (self.t_bateria, self.t_consumo, self.t_cpu):
            hs.addWidget(w, 1)
        raiz.addWidget(caja_sis)
        raiz.addStretch()

    def refrescar(self):
        temps = hw.temperaturas()
        for nombre, valor in temps.items():
            if nombre not in self.medidores:
                m = Medidor(nombre)
                self.medidores[nombre] = m
                self.rej_temp.addWidget(m, 0, len(self.medidores) - 1)
            self.medidores[nombre].set_valor(valor)
        # Un sensor que desaparece se marca sin dato en lugar de quedarse con
        # la ultima lectura, que enganaria. La GPU es el caso habitual: el EC
        # no puede medirla mientras esta fuera del bus o suspendida.
        for nombre, m in self.medidores.items():
            if nombre not in temps:
                m.set_valor(None)
        if "GPU" not in temps and "GPU" not in self.medidores:
            m = Medidor("GPU apagada")
            self.medidores["GPU"] = m
            self.rej_temp.addWidget(m, 0, len(self.medidores) - 1)

        rpm = hw.ventiladores_rpm()
        if rpm:
            self.fan_cpu.set_rpm(rpm[0])
            self.fan_gpu.set_rpm(rpm[1] if len(rpm) > 1 else None)
        else:
            self.fan_cpu.set_rpm(None)
            self.fan_gpu.set_rpm(None)

        b = hw.bateria()
        estados = {"Charging": "cargando", "Discharging": "descargando",
                   "Not charging": "en el tope", "Full": "llena",
                   "Unknown": "sin dato"}
        estado = estados.get(b["estado"], b["estado"])
        self.t_bateria.set(f"{b['capacidad']} %", estado)

        c = b["consumo_mw"]
        # Solo hay cifra fiable descargando: cargando, la corriente de la
        # bateria es la de carga, no la que gasta el sistema.
        if c is None:
            self.t_consumo.set("--", f"no medible {estado}")
        else:
            self.t_consumo.set(f"{c / 1000:.1f} W", f"{c} mW")

        i = hw.cpu_info()
        self.t_cpu.set(f"{i['mhz'] or '--'} MHz",
                       f"{i['governor']} · EPP {i['epp'] or 'n/d'} · "
                       f"turbo {i['turbo']}")


class PaginaVentiladores(QWidget):
    def __init__(self):
        super().__init__()
        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 18)
