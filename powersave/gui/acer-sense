def fila(etiqueta, widget, pista=None):
    caja = QVBoxLayout()
    linea = QHBoxLayout()
    lbl = QLabel(etiqueta)
    lbl.setMinimumWidth(170)
    linea.addWidget(lbl)
    linea.addWidget(widget, 1)
    caja.addLayout(linea)
    if pista:
        p = QLabel(pista)
        p.setObjectName("pista")
        p.setWordWrap(True)
        caja.addWidget(p)
    return caja


def _deslizador(minimo, maximo, valor, sufijo):
    """Deslizador con su lectura al lado. Devuelve (slider, etiqueta, caja)."""
    sl = QSlider(Qt.Orientation.Horizontal)
    sl.setRange(minimo, maximo)
    sl.setSingleStep(1)
    sl.setPageStep(max(1, (maximo - minimo) // 10))
    sl.setValue(valor)
    lb = QLabel(f"{valor}{(' ' + sufijo) if sufijo else ''}")
    lb.setObjectName("dato")
    lb.setMinimumWidth(52)
    cont = QWidget()
    lay = QHBoxLayout(cont)
    lay.setContentsMargins(0, 0, 0, 0)
    lay.addWidget(sl, 1)
    lay.addWidget(lb)
    sl.valueChanged.connect(
        lambda x: lb.setText(f"{x}{(' ' + sufijo) if sufijo else ''}"))
    return sl, lb, cont


class ControlesEnUso:
    """Evita que el refresco periodico pise lo que el usuario esta ajustando.

    El problema que resuelve: los deslizadores se llevaban a una posicion y
    volvian sola al valor anterior. isSliderDown() sólo protege MIENTRAS se
    arrastra; en cuanto se suelta, el siguiente refresco leia el hardware --que
    todavia no habia aplicado el cambio, o lo reporta por otra via-- y
    machacaba la posicion.

    La solucion es un periodo de gracia: durante unos segúndos despues de
    tocar un control, el refresco lo deja en paz.
    """

    GRACIA = 2.5      # segúndos

    def __init__(self):
        self._tocados = {}

    def marcar(self, widget):
        self._tocados[widget] = time.monotonic()

    def vigilar(self, *widgets):
        """Conecta los deslizadores para que se marquen solos al tocarlos."""
        for w in widgets:
            w.sliderPressed.connect(lambda w=w: self.marcar(w))
            w.valueChanged.connect(lambda _, w=w: self.marcar(w))

    def libre(self, widget):
        """True si el refresco puede escribir en este control."""
        if widget.isSliderDown():
            return False
        return time.monotonic() - self._tocados.get(widget, 0.0) > self.GRACIA


