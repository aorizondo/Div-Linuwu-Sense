        self.lb_rpm_gpu = QLabel("-- rpm")
        for sl, lb, rpm, et in ((self.sl_cpu, self.lb_cpu, self.lb_rpm_cpu, "CPU"),
                                (self.sl_gpu, self.lb_gpu, self.lb_rpm_gpu, "GPU")):
            sl.setRange(0, 100)
            sl.setSingleStep(1)     # flechas: de uno en uno
            sl.setPageStep(10)      # rueda y AvPag: de diez en diez
            lb.setMinimumWidth(48)
            lb.setObjectName("dato")
            # El porcentaje es lo que se pide; las rpm son lo que el EC hace de
            # verdad. No siempre coinciden, asi que se muestran los dos.
            rpm.setMinimumWidth(78)
            rpm.setObjectName("dato")
            linea = QHBoxLayout()
            linea.addWidget(QLabel(et))
            linea.addWidget(sl, 1)
            linea.addWidget(lb)
            linea.addWidget(rpm)
            vman.addLayout(linea)
        self.sl_cpu.valueChanged.connect(lambda v: self.lb_cpu.setText(f"{v} %"))
        self.sl_gpu.valueChanged.connect(lambda v: self.lb_gpu.setText(f"{v} %"))
        self.sl_cpu.sliderReleased.connect(self._aplicar_manual)
        self.sl_gpu.sliderReleased.connect(self._aplicar_manual)
        raiz.addWidget(self.caja_manual)

        self.caja_curva = QGroupBox(
            "CURVA  ·  ARRASTRA LOS PUNTOS PARA FIJAR DESDE QUE Temperatura "
            "GIRAN Y COMO ESCALAN")
        vc = QVBoxLayout(self.caja_curva)
        self.curva = EditorCurva()
        vc.addWidget(self.curva)
        pie = QHBoxLayout()
        self.lbl_curva = QLabel("--")
        self.lbl_curva.setObjectName("dato")
        pie.addWidget(self.lbl_curva, 1)
        b_guardar = QPushButton("Guardar como curva del sistema")
        b_guardar.clicked.connect(self._guardar_curva)
        pie.addWidget(b_guardar)
        vc.addLayout(pie)
        raiz.addWidget(self.caja_curva, 1)
        # Solo se ajusta la vista. Aplicar aqui ponia los ventiladores en
        # automatico cada vez que se abria la aplicacion, tirando por tierra
        # el modo que tuviera puesto el usuario.
        self._mostrar_modo(0)
        self._modo_detectado = False

    def _mostrar_modo(self, idx):
        """Solo visibilidad: no toca el hardware."""
        self.caja_manual.setVisible(idx == 1)
        self.caja_curva.setVisible(idx == 2)

    def _modo_cambiado(self, idx):
        """Lo llama el usuario al pulsar un boton: aqui si se aplica."""
        self._mostrar_modo(idx)
        self._modo_detectado = True          # a partir de ahora manda el usuario
        if idx == 0:
            ok, err = hw.fan_auto()
            if not ok:
                QMessageBox.warning(self, "Ventiladores", err)

    def _detectar_modo(self):
        """Selecciona el boton que corresponde a lo que el hardware tiene.

        Se hace una sola vez, al primer refresco: despues manda lo que elija
        el usuario. fan_speed a 0,0 es el modo automatico del EC; cualquier
        otro valor es una velocidad fijada a mano.
        """
        if self._modo_detectado:
            return
        self._modo_detectado = True
        v = hw.fan_get()
        if not v:
            return
        manual = any(x > 0 for x in v)
        idx = 1 if manual else 0
        self.grupo.blockSignals(True)
        self.grupo.button(idx).setChecked(True)
        self.grupo.blockSignals(False)
        self._mostrar_modo(idx)
        if manual:
            self.sl_cpu.blockSignals(True)
            self.sl_gpu.blockSignals(True)
            self.sl_cpu.setValue(v[0])
            self.sl_gpu.setValue(v[1] if len(v) > 1 else v[0])
            self.sl_cpu.blockSignals(False)
            self.sl_gpu.blockSignals(False)

    def _aplicar_manual(self):
        ok, err = hw.fan_set(self.sl_cpu.value(), self.sl_gpu.value())
        if not ok:
            QMessageBox.warning(self, "Ventiladores", err)

    def _guardar_curva(self):
        puntos = sorted(self.curva.puntos)
        # El primer punto marca desde que temperatura giran: por debajo quedan
        # parados, que es justo lo que se busca para el silencio en reposo.
        t_min = puntos[0][0]
        curva = ",".join(f"{t}:{p}" for t, p in puntos[1:]) or f"{t_min + 10}:30"
        ok, err = hw.guardar_curva(t_min, curva)
        if ok:
            QMessageBox.information(
                self, "Curva de ventiladores",
                f"Guardada. Los ventiladores quedan parados por debajo de "
                f"{t_min} °C.\n\nPara que la aplique de forma continua:\n"
                "  sudo systemctl restart acer-powersave")
        else:
            QMessageBox.warning(self, "Curva de ventiladores",
                                err or "no se pudo guardar")

    def refrescar(self):
        self._detectar_modo()
        rpm = hw.ventiladores_rpm()
        if rpm:
            self.fan_cpu.set_rpm(rpm[0])
            self.lb_rpm_cpu.setText(f"{rpm[0]} rpm")
            if len(rpm) > 1:
                self.fan_gpu.set_rpm(rpm[1])
                self.lb_rpm_gpu.setText(f"{rpm[1]} rpm")
        else:
            self.fan_cpu.set_rpm(None)
            self.fan_gpu.set_rpm(None)

        estado = hw.fan_get()
        if estado and self.grupo.checkedId() != 1:
            for sl, v in ((self.sl_cpu, estado[0]), (self.sl_gpu, estado[1])):
                sl.blockSignals(True)
                sl.setValue(v)
                sl.blockSignals(False)
        t = hw.temperaturas().get("CPU")
        if t is not None:
            self.curva.set_temp_actual(t)
            if self.grupo.checkedId() == 2:
                pct = self.curva.porcentaje_para(t)
                self.lbl_curva.setText(f"a {t:.0f} °C la curva pide {pct} %")
                hw.fan_set(pct, pct)


class PaginaTeclado(QWidget):
    """Retroiluminación: efecto arriba, teclado dibujado abajo.

    El teclado no es decoracion: es el control. Se pulsa la zona que se quiere
    cambiar, en lugar de adivinar cual de cuatro botones numerados corresponde
    a que parte del teclado.
    """

    def __init__(self):
        super().__init__()
        self.color = QColor("#00c8d7")
        self.colores_zona = [QColor("#00c8d7") for _ in range(4)]
        self.en_uso = ControlesEnUso()

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(22, 18, 22, 16)
        raiz.setSpacing(14)
        t = QLabel("Retroiluminación del teclado")
        t.setObjectName("titulo")
        raiz.addWidget(t)

        # --- efecto -------------------------------------------------------
        caja = QGroupBox("EFECTO")
        v = QVBoxLayout(caja)
        v.setSpacing(10)

        self.cb_efecto = QComboBox()
        for i, (nombre, _, soportado) in enumerate(hw.EFECTOS):
            self.cb_efecto.addItem(
                nombre if soportado else f"{nombre}  ·  no soportado")
            if not soportado:
                self.cb_efecto.model().item(i).setEnabled(False)
        self.cb_efecto.setCurrentIndex(2)
        self.cb_efecto.currentIndexChanged.connect(self._efecto_cambiado)
        v.addLayout(fila("Efecto", self.cb_efecto))

        self.b_color = QPushButton()
        self.b_color.setObjectName("muestra")
        self.b_color.setMinimumHeight(34)
        self.b_color.clicked.connect(self._elegir_color)
        v.addLayout(fila("Color", self.b_color))

        self.sl_brillo, self.lb_brillo, cb = _deslizador(0, 100, 100, "%")
        v.addLayout(fila("Brillo", cb))

        self.sl_vel, self.lb_vel, cv = _deslizador(
            hw.VELOCIDAD_MIN, hw.VELOCIDAD_MAX, 3, "")
        self.sl_vel.setTickPosition(QSlider.TickPosition.TicksBelow)
        self.sl_vel.setTickInterval(1)
        v.addLayout(fila("Velocidad", cv))

        self.sel_dir = SelectorDireccion()
        self.sel_dir.cambiada.connect(lambda _: self._aplicar_silencioso())
        v.addLayout(fila("Dirección", self.sel_dir))

        acciones = QHBoxLayout()
        b_aplicar = QPushButton("Aplicar")
        b_aplicar.setObjectName("primario")
        b_aplicar.clicked.connect(self._aplicar)
        b_apagar = QPushButton("Apagar")
        b_apagar.clicked.connect(self._apagar)
        acciones.addWidget(b_aplicar)
        acciones.addWidget(b_apagar)
        acciones.addStretch()
        v.addLayout(acciones)
        raiz.addWidget(caja)

        # --- zonas --------------------------------------------------------
        caja_z = QGroupBox("COLOR POR ZONA  ·  PULSA UNA ZONA PARA CAMBIARLA")
        vz = QVBoxLayout(caja_z)
        vz.setSpacing(10)
        self.teclado = TecladoZonas()
        self.teclado.zona_pulsada.connect(self._elegir_zona)
        vz.addWidget(self.teclado)

        pie = QHBoxLayout()
        b_igualar = QPushButton("Igualar las cuatro")
        b_igualar.clicked.connect(self._igualar_zonas)
        pie.addWidget(b_igualar)
        pie.addStretch()
        vz.addLayout(pie)
        raiz.addWidget(caja_z)
        raiz.addStretch()

        self.en_uso.vigilar(self.sl_brillo, self.sl_vel)
        self.sl_brillo.sliderReleased.connect(self._aplicar_silencioso)
        self.sl_vel.sliderReleased.connect(self._aplicar_silencioso)
        self.sl_brillo.valueChanged.connect(self.teclado.set_brillo)
        self._pintar_boton()
        self._efecto_cambiado(self.cb_efecto.currentIndex())

    # -- estado de los controles -----------------------------------------
    def _efecto_valor(self):
        return hw.EFECTOS[self.cb_efecto.currentIndex()][1]

    def _efecto_cambiado(self, _):
        """Habilita sólo lo que el efecto elegido usa de verdad."""
        efecto = self._efecto_valor()
        anima = efecto != 0
        usa_color = efecto not in (2, 3)        # Neon y Onda lo eligen ellos
        usa_direccion = efecto in (3, 4)        # Onda y Desplazamiento
        self.sl_vel.setEnabled(anima)
        self.lb_vel.setEnabled(anima)
        self.sel_dir.setEnabled(usa_direccion)
        self.b_color.setEnabled(usa_color)

    def _pintar_boton(self):
        c = self.color
        self.b_color.setText(c.name().upper())
        self.b_color.setStyleSheet(
            f"background: {c.name()}; border: 1px solid #2f3a44; "
            f"color: {'#000' if c.lightness() > 127 else '#fff'};")

    def _elegir_color(self):
        c = QColorDialog.getColor(self.color, self, "Color del teclado")
        if c.isValid():
            self.color = c
            self._pintar_boton()
            self._aplicar_silencioso()

    def _elegir_zona(self, idx):
        c = QColorDialog.getColor(self.colores_zona[idx], self,
                                  f"Color de la zona {idx + 1}")
        if c.isValid():
            self.colores_zona[idx] = c
            self.teclado.set_colores(self.colores_zona)
            self._aplicar_zonas()

    def _igualar_zonas(self):
        self.colores_zona = [QColor(self.color) for _ in range(4)]
        self.teclado.set_colores(self.colores_zona)
        self._aplicar_zonas()

    # -- aplicar ----------------------------------------------------------
    def _aplicar(self):
        ok, err = self._escribir()
        if not ok:
            QMessageBox.warning(self, "Teclado", err)

    def _aplicar_silencioso(self):
        """Lo llaman los controles al soltarlos: aqui un dialogo por cada
        fallo llenaria la pantalla, y el fallo ya se ve en el teclado."""
        self._escribir()

    def _escribir(self):
        efecto = self._efecto_valor()
        if efecto == 0:
            # El estatico va por per_zone_mode: es el unico camino que activa
            # las zonas, y sin ellas el efecto 0 deja el teclado a oscuras.
            return self._aplicar_zonas()
        return hw.kb_set(efecto, self.sl_vel.value(), self.sl_brillo.value(),
                         self.sel_dir.valor,
                         (self.color.red(), self.color.green(),
                          self.color.blue()))

    def _aplicar_zonas(self):
        colores = [f"{c.red():02x}{c.green():02x}{c.blue():02x}"
                   for c in self.colores_zona]
        ok, err = hw.kb_zonas_set(colores, self.sl_brillo.value())
        if not ok:
            QMessageBox.warning(self, "Teclado", err)
        return ok, err

    def _apagar(self):
        ok, err = hw.kb_apagar()
        if not ok:
            QMessageBox.warning(self, "Teclado", err)

    # -- refresco ---------------------------------------------------------
    def refrescar(self):
        est = hw.kb_get()
        if est and not self.cb_efecto.hasFocus():
            for i, (_, valor, _) in enumerate(hw.EFECTOS):
                if valor == est["efecto"]:
                    self.cb_efecto.blockSignals(True)
                    self.cb_efecto.setCurrentIndex(i)
                    self.cb_efecto.blockSignals(False)
                    self._efecto_cambiado(i)
                    break

        if est and self.en_uso.libre(self.sl_brillo):
            self.sl_brillo.blockSignals(True)
            self.sl_brillo.setValue(est["brillo"])
            self.sl_brillo.blockSignals(False)
            self.lb_brillo.setText(f"{est['brillo']} %")
            self.teclado.set_brillo(est["brillo"])

        if est and self.en_uso.libre(self.sl_vel):
            self.sl_vel.blockSignals(True)
            self.sl_vel.setValue(est["velocidad"])
            self.sl_vel.blockSignals(False)
            self.lb_vel.setText(str(est["velocidad"]))

        if est and est["direccion"] in (1, 2):
            self.sel_dir.set_valor(est["direccion"])

        zonas = hw.kb_zonas_get()
        if zonas:
            colores, _ = zonas
            for i, hexa in enumerate(colores[:4]):
                try:
                    self.colores_zona[i] = QColor("#" + hexa)
                except ValueError:
                    pass
            self.teclado.set_colores(self.colores_zona)


