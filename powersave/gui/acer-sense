        aspas.addStretch()
        aspas.addWidget(self.fan_cpu)
        aspas.addSpacing(24)
        aspas.addWidget(self.fan_gpu)
        aspas.addStretch()
        vm.addLayout(aspas)
        aviso = QLabel(
            "El botón Turbo del portátil pone los ventiladores al máximo por "
            "su cuenta, saltandose este panel: lo gestiona el driver y su "
            "estado no se puede consultar, así que si lo activas manda el.")
