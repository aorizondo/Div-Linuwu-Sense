        vl = QVBoxLayout(lateral)
        vl.setContentsMargins(0, 16, 0, 16)
        vl.setSpacing(2)

        marca = QLabel("  ACER SENSE")
        marca.setStyleSheet(
            f"color: {ACENTO.name()}; font-size: 12pt; font-weight: 700; "
            "letter-spacing: 2px; padding: 8px 16px 18px 16px;")
        vl.addWidget(marca)

        self.pila = QStackedWidget()
        paginas = [("Monitorización", PaginaMonitor()),
                   ("Ventiladores", PaginaVentiladores()),
                   ("Teclado", PaginaTeclado()),
                   ("Energía", PaginaEnergia()),
                   ("Batería y sistema", PaginaSistema())]
        self.grupo_nav = QButtonGroup(self)
        for i, (nombre, pagina) in enumerate(paginas):
            b = QPushButton(nombre)
            b.setObjectName("nav")
            b.setCheckable(True)
            self.grupo_nav.addButton(b, i)
            vl.addWidget(b)
            self.pila.addWidget(pagina)
        self.grupo_nav.button(0).setChecked(True)
        self.grupo_nav.idClicked.connect(self.pila.setCurrentIndex)
        vl.addStretch()

        self.lbl_driver = QLabel()
        self.lbl_driver.setObjectName("pista")
        self.lbl_driver.setWordWrap(True)
        self.lbl_driver.setStyleSheet("padding: 8px 16px;")
        vl.addWidget(self.lbl_driver)

        raiz.addWidget(lateral)
        raiz.addWidget(self.pila, 1)

        self.temporizador = QTimer(self)
        self.temporizador.timeout.connect(self.refrescar)
        self.temporizador.start(2000)
        self.refrescar()

    def refrescar(self):
        if not hw.driver_presente():
            self.lbl_driver.setText(
                "Módulo linuwu_sense no cargado: ventiladores, teclado y "
                "batería no responden.")
        else:
            panel = hw.panel()
            self.lbl_driver.setText(
                "driver · " + (panel.name if panel else "activo"))
        # Sólo se refresca la pagina visible: leer sysfs cuesta y algunas
        # lecturas despiertan al firmware.
        actual = self.pila.currentWidget()
        if hasattr(actual, "refrescar"):
            actual.refrescar()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Acer Sense")
    app.setDesktopFileName("acer-sense")
    # Sin esto Wayland pinta el icono generico en la barra de tareas.
    icono = QIcon.fromTheme("acer-sense")
    if icono.isNull():
        for ruta in ("/usr/share/icons/hicolor/scalable/apps/acer-sense.svg",
                     os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                  "acer-sense.svg")):
            if os.path.exists(ruta):
                icono = QIcon(ruta)
                break
    if not icono.isNull():
        app.setWindowIcon(icono)
    app.setStyleSheet(HOJA_ESTILO)

    if not hw.driver_presente():
        QMessageBox.warning(
            None, "Acer Sense",
            "No se encuentra el módulo linuwu_sense.\n\n"
            "Instala el paquete linuwu-sense-dkms y reinicia, o cargalo con:\n"
            "  sudo modprobe linuwu_sense")

    v = Ventana()
    v.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
